# PURPOSE: Conservative Tencent Sports response cleanup for high-confidence ads, with optional promotional UI cleanup.
# LINK: https://raw.githubusercontent.com/carolcheng520/anyrule-dist/main/mitm/TencentSportsAdBlock.amrs
# SOURCE: https://raw.githubusercontent.com/Hey-sayiwanna/TencentSports-Surge/aad85d3669ababee8d64cd6e245b6d0546250bd0/TencentSportsAdBlock.sgmodule
# SOURCE-REVISION: aad85d3669ababee8d64cd6e245b6d0546250bd0
# SOURCE-SHA256: TencentSportsAdBlock.sgmodule=4987d3d24b0947366e950cbfe06b5d4aecd61b6c6bd258d9fe8a354c0615da75; TencentSportsAdBlock.js=07ce795cb38bbfc77d771c1eefbb70577d49e44d44c071e27b09dd05bad62427; TencentSportsFloatBlock.js=e62e26451ab1f2107d054ab9b311fcdbd13edb3ddedadcec6ef130b3cf9c291f
# LAST-UPDATED: 2026-08-20
# SUGGESTED-ACTION: Enable MITM
# RULES: 10
# COMPANION-FILES: Standalone. Upstream recommends broad ad-platform and HTTPDNS REJECT modules for pre-roll video ads; they are omitted here because their scope is not Tencent Sports-specific.

name = Tencent Sports Ad Block
hostname = app.sports.qq.com, shequ.sports.qq.com, film.video.qq.com, sports.qq.com, matchweb.sports.qq.com

[Parameter]
1, 0, mode, Cleanup mode, Conservative keeps unknown and operational UI; cleanup also removes explicitly identified promotional UI and CoinLayer., conservative, "[conservative, cleanup]"

[Rule]
1, 100, ^https://app\.sports\.qq\.com/feeds/list(?:\?.*)?$, 
1, 100, ^https://app\.sports\.qq\.com/m/matchAfter/stats(?:\?.*)?$, 
1, 100, ^https://app\.sports\.qq\.com/match/adBanner(?:\?.*)?$, 
1, 100, ^https://shequ\.sports\.qq\.com/topic/detail(?:\?.*)?$, 
1, 100, ^https://app\.sports\.qq\.com/trpc\.sports_resource\.cgi\.ResourceCGI/MatchWidgets(?:\?.*)?$, 
1, 100, ^https://app\.sports\.qq\.com/vaccess/trpc\.sports_resource\.cgi\.ResourceCGI/ColumnWidget(?:\?.*)?$, 
1, 100, ^https://app\.sports\.qq\.com/vaccess/trpc\.sportsbasic\.column\.Column/GetColumn(?:\?.*)?$, 
1, 100, ^https://sports\.qq\.com/sapp/h5msg\.htm(?:\?.*)?$, 
1, 100, ^https://matchweb\.sports\.qq\.com/trpc\.dorae\.coin\.Coin/CoinLayer(?:\?.*)?$, 
1, 100, ^https://film\.video\.qq\.com/x/sports-vip-channel/(?:\?.*)?$, 
