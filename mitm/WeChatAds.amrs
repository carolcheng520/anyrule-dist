# PURPOSE: Conservative cleanup for known WeChat Official Account ad data and exact ad-media paths.
# LINK: https://raw.githubusercontent.com/carolcheng520/anyrule-dist/main/mitm/WeChatAds.amrs
# UPSTREAM: https://gitlab.com/lodepuly/vpn_tool/-/raw/main/Tool/Loon/Plugin/Weixin_Official_Accounts_remove_ads.plugin
# UPSTREAM-SNAPSHOT: 2024-07-26
# LAST-UPDATED: 2026-08-28
# SUGGESTED-ACTION: Enable MITM
# RULES: 4
# COMPANION-FILES: Use with rules/wechat-ads.arrs
# LOCAL-CHANGES: Preserve unknown getappmsgad fields; retain exact reserved ad-media paths; pass through promotion, recommendation, monitoring, and unknown endpoints.

name = WeChat Ads
hostname = mp.weixin.qq.com, wximg.wxs.qq.com, wxsmw.wxs.qq.com

1, 5, ^https://mp\.weixin\.qq\.com/mp/getappmsgad(?:\?|$), replace, $.advertisement_num, 0
1, 5, ^https://mp\.weixin\.qq\.com/mp/getappmsgad(?:\?|$), replace, $.advertisement_info, []
0, 0, ^https?://wximg\.wxs\.qq\.com/\d+/\d+/snscosdownload/(?:SH|SZ)/reserved/[^?]+(?:\?|$), 3
0, 0, ^https?://wxsmw\.wxs\.qq\.com/\d+/\d+/snssvpdownload/(?:SH|SZ)/reserved/[^?]+(?:\?|$), 3
