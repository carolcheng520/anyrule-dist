# SUGGESTED-ACTION: PROXY
# RULES: 5

name = Apple Podcasts Proxy
2, podcasts.apple.com
2, sf-api-token-service.itunes.apple.com
2, bookkeeper.itunes.apple.com
2, search.itunes.apple.com
2, play.itunes.apple.com
